# ==============================================================================
# Kisan Salah - Global Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Environment Variables (Vercel Backend Project)
# ------------------------------------------------------------------------------

# 1. Data.gov.in Agmarknet API Key (Required for Live Mandi Bhav)
# Register and generate an API key at https://data.gov.in
DATA_GOV_API_KEY=your_data_gov_in_api_key_here

# 2. Groq Cloud API Key (Required for Groq Whisper STT & Fast AI Advisor)
# Obtain your free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# 3. OpenRouter API Key (Optional secondary LLM fallback)
# Obtain at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# 4. Allowed Origins (Optional - defaults to * and *.vercel.app)
# ALLOWED_ORIGINS=https://your-frontend.vercel.app

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Vercel Frontend Project)
# ------------------------------------------------------------------------------

# Public URL pointing to your deployed FastAPI backend:
# In Local Dev: http://localhost:8000
# In Vercel Production: https://your-backend-project.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:8000
