# ==============================================================================
# Kisan Salah Backend Environment Template
# ==============================================================================
# Copy this file to .env inside the backend directory:
#   cp .env.example .env

# Data.gov.in API Key for Agmarknet Mandi Prices (Register at https://data.gov.in)
DATA_GOV_API_KEY=your_data_gov_in_api_key_here

# Groq Cloud API Key for AI Advisory & Whisper Speech-to-Text (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# (Optional) OpenRouter Fallback Model (https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
